LocHelpText="Octroie une grenade fumigène gratuite dans votre inventaire."
LocPromotionPopupText="<Bullet/> Octroie une grenade fumigène gratuite dans votre inventaire.<br/>"

[Savior X2AbilityTemplate]
LocFriendlyName="Sauveur"
